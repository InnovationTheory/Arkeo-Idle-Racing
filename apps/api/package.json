{
  "name": "arkeo-racing-api",
  "private": true,
  "version": "0.1.0",
  "type": "commonjs",
  "scripts": {
    "dev": "tsc -w",
    "build": "prisma generate && tsc -p tsconfig.json && node scripts/copy-profanity.js && cp src/openapi.yaml dist/src/",
    "start": "node dist/src/index.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma db push",
    "db:seed": "node dist/prisma/seed.js"
  },
  "dependencies": {
    "@cosmjs/proto-signing": "^0.38.1",
    "@cosmjs/stargate": "^0.38.1",
    "@prisma/client": "^5.18.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^5.18.0",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.18.0",
    "yaml": "^2.8.2",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.11.6",
    "@types/pino": "^7.0.4",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.5.10",
    "@vitest/coverage-v8": "^3.2.4",
    "supertest": "^7.2.2",
    "typescript": "^5.5.4",
    "vitest": "^3.2.4"
  }
}
