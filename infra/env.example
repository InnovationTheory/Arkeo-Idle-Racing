# API
DATABASE_URL=postgres://arkeo:arkeo@postgres:5432/arkeo_racing
DATABASE_URL_SINGLE=postgres://arkeo:arkeo@localhost:5432/arkeo_racing
HTTP_PORT=8081
WS_PATH=/ws
RACING_MODE=live
PAYOUT_CAP_RATIO=0.90
ENTRY_FEE=100
ENTRY_FEE_UARKEO=100
PICK3_FEE_UARKEO=300
RACE_INTERVAL_SECS=30
PICK_WINDOW_SECS=300
AUTO_RACE_ENABLED=0
RESET_RACE_ON_BOOT=1
HORSES_PER_RACE=10
VOID_FIRST_TICKS=10
VOID_START_GRACE_SECS=60
MAX_CONCURRENCY_PER_HORSE=20
MAX_CONCURRENCY_GLOBAL=100
POLL_TIMEOUT_MS=1500
SUBSCRIBER_BASE_URL=http://subscriber-core:9998
SUBSCRIBER_SERVICES_PATH=/api/services
SUBSCRIBER_PROBE_PATH=/api/probe
SUBSCRIBER_ACTIVE_SERVICE_TYPES_PATH=/api/active-service-types
SUBSCRIBER_ACTIVE_SERVICES_PATH=/api/active-services
SUBSCRIBER_ACTIVE_PROVIDERS_PATH=/api/active-providers
SUBSCRIBER_LISTENERS_PATH=/api/listeners
SUBSCRIBER_SNAPSHOT_DIR=/app/data/subscriber
SUBSCRIBER_DISCOVERY_TTL_SECS=60
POSTHOG_ENABLED=0
POSTHOG_HOST=
POSTHOG_API_KEY=
INITIAL_CREDITS=10000
RACEDAY_TICK_MS=1000
RACEDAY_DURATION_SECS=720
RACEDAY_PICK_WINDOW_SECS=10800
RACEDAY_BUFFER_SECS=60
RACEDAY_MAX_PARALLEL_HEATS=1
PRISMA_ACCEPT_DATA_LOSS=1
ARKEO_CHAIN_ID=arkeo-main-v1
ARKEO_CHAIN_NAME=Arkeo
ARKEO_RPC_URL=https://rpc-seed.arkeo.network
ARKEO_LCD_URL=https://rest-seed.arkeo.network
ARKEO_DENOM=uarkeo
ARKEO_DECIMALS=8
ARKEO_TICKER=ARKEO
ARKEO_BECH32_PREFIX=arkeo
ARKEOD_ENABLED=1
ARKEOD_REQUIRED=0
ARKEOD_DOWNLOAD_URL=
ARKEOD_HOME=/app/data/arkeo
ARKEOD_KEY_NAME=arkeo-racing-hot
ARKEOD_KEYRING_BACKEND=test
ARKEOD_KEYRING_PASSWORD=
ARKEOD_MNEMONIC=
ARKEOD_ENV_PATH=/app/.env
ARKEOD_BUILD_FROM_SOURCE=1
ARKEOD_SOURCE_REPO=https://github.com/arkeonetwork/arkeo.git
ARKEOD_SOURCE_REF=master

# Postgres (single-container overrides)
POSTGRES_DB=arkeo_racing
POSTGRES_USER=arkeo
POSTGRES_PASSWORD=arkeo
PGDATA=/var/lib/postgresql/data/pgdata

# Web
VITE_API_BASE_URL=http://localhost:8081
VITE_WS_URL=ws://localhost:8081/ws
VITE_AUTO_RACE_ENABLED=0
VITE_ARKEO_CHAIN_ID=arkeo-main-v1
VITE_ARKEO_CHAIN_NAME=Arkeo
VITE_ARKEO_RPC_URL=https://rpc-seed.arkeo.network
VITE_ARKEO_LCD_URL=https://rest-seed.arkeo.network
VITE_ARKEO_DENOM=uarkeo
VITE_ARKEO_DECIMALS=8
VITE_ARKEO_TICKER=ARKEO
VITE_ARKEO_BECH32_PREFIX=arkeo
VITE_ARKEO_GAS_PRICE=0.025uarkeo
VITE_ARKEO_GAS_LIMIT=200000
